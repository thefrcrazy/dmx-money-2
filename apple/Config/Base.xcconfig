// Réglages communs. Pour signer (iCloud, distribution), créer Config/Signing.local.xcconfig :
//   DEVELOPMENT_TEAM = XXXXXXXXXX
//   DMX_ENTITLEMENTS_SUFFIX = -iCloud
DMX_ENTITLEMENTS_SUFFIX =
// Conteneur CloudKit (ex. iCloud.com.dmxmoney.app) : vide = synchronisation iCloud indisponible.
DMX_ICLOUD_CONTAINER =
// Flux personnalisé : vide = releases GitHub V2 par défaut.
DMX_UPDATE_FEED_URL =

// Les valeurs locales doivent suivre les défauts pour ne pas être écrasées.
#include? "Signing.local.xcconfig"
