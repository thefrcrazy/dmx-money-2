<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DmxMoney.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DmxMoney.App"
    xmlns:tray="using:H.NotifyIcon"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DmxMoney">

    <Grid x:Name="Root" Background="{ThemeResource DmxPageBackground}">

        <tray:TaskbarIcon
            x:Name="Tray"
            ToolTipText="DmxMoney"
            IconSource="ms-appx:///Assets/dmxmoney.ico"
            NoLeftClickDelay="True"
            LeftClickCommand="{x:Bind ShowWindowCommand}" />

        <NavigationView
            x:Name="Nav"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="224"
            ItemInvoked="OnNavigationItemInvoked">

            <NavigationView.PaneFooter>
                <StackPanel Padding="12,4,12,12" Spacing="4">
                    <Button
                        x:Name="QuitButton"
                        Click="OnQuit"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <local:LucideIcon Glyph="Power" Size="16" Stroke="{ThemeResource DmxExpense}" />
                            <TextBlock Text="Quitter" Foreground="{ThemeResource DmxExpense}" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="VersionLabel"
                        Style="{StaticResource DmxSectionLabel}"
                        HorizontalAlignment="Center"
                        Opacity="0.6" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid RowDefinitions="Auto,Auto,*">

                <!-- Filtre global de comptes et soldes Pointé / Actuel -->
                <Grid x:Name="Header" Padding="24,12" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                    <TextBlock
                        Grid.Column="0"
                        x:Name="FilterLabel"
                        Text="Compte :"
                        VerticalAlignment="Center"
                        Style="{StaticResource DmxCaption}" />
                    <DropDownButton Grid.Column="1" x:Name="AccountFilterButton" MinWidth="220" HorizontalContentAlignment="Left">
                        <DropDownButton.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Width="280" Spacing="8">
                                    <ListView
                                        x:Name="AccountFilterList"
                                        SelectionMode="Multiple"
                                        MaxHeight="320"
                                        SelectionChanged="OnAccountFilterChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:AccountFilterItem">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <local:LucideIcon Glyph="{x:Bind Icon}" Size="14" Stroke="{x:Bind Brush}" />
                                                    <TextBlock Text="{x:Bind Name}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Button Content="Tous les comptes" Click="OnClearAccountFilter" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <StackPanel Grid.Column="3" x:Name="BalancePanel" Orientation="Horizontal" Spacing="20">
                        <StackPanel>
                            <TextBlock Text="POINTÉ" Style="{StaticResource DmxSectionLabel}" HorizontalAlignment="Right" />
                            <TextBlock x:Name="CheckedBalance" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource DmxIncome}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Rectangle Width="1" Height="30" Fill="{ThemeResource DmxSeparator}" />
                        <StackPanel>
                            <TextBlock Text="ACTUEL" Style="{StaticResource DmxSectionLabel}" HorizontalAlignment="Right" />
                            <TextBlock x:Name="CurrentBalance" FontSize="19" FontWeight="Bold" HorizontalAlignment="Right" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{ThemeResource DmxSeparator}" />

                <Frame Grid.Row="2" x:Name="ContentFrame" />

                <InfoBar
                    Grid.Row="2"
                    x:Name="Toast"
                    IsOpen="False"
                    IsClosable="True"
                    Severity="Success"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="24" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
