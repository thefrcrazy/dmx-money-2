<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DmxMoney.App</RootNamespace>
    <AssemblyName>DmxMoney</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\dmxmoney.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Active la génération et la publication du PRI contenant le XAML compilé. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Les targets MSIX du SDK 2.x nomment par défaut le PRI DmxMoney.pri pour une app
         non empaquetée. Garder le nom contrôlé par notre script de publication. -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <!-- Application non empaquetée : installation et mises à jour par Velopack. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Main écrit à la main : Velopack doit s'exécuter avant l'initialisation de WinUI. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DmxMoney.Interop\DmxMoney.Interop.csproj" />
    <ProjectReference Include="..\DmxMoney.ViewModels\DmxMoney.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bibliothèque native du noyau Rust, copiée par scripts/build-windows.ps1. -->
    <None Include="..\DmxMoney.Interop\runtimes\**\native\*" CopyToOutputDirectory="PreserveNewest" Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
