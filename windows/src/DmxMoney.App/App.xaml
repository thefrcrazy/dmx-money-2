<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DmxMoney.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Theme.xaml" />
                <!-- Instancié par sa classe : ses modèles utilisent x:Bind, que Source= ne branche pas. -->
                <local:FormTemplates xmlns:local="using:DmxMoney.App" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
