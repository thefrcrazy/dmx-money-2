<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DmxMoney.App.PredictionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DmxMoney.App"
    xmlns:interop="using:DmxMoney.Interop">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="1280">
            <Grid>
                <TextBlock Text="Prédictions Financières" Style="{StaticResource DmxPageTitle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <ComboBox x:Name="RangeBox" MinWidth="170" DisplayMemberPath="Label" SelectionChanged="OnRangeChanged" />
                    <CalendarDatePicker x:Name="EndPicker" Header="Jusqu'au" Visibility="Collapsed" DateChanged="OnEndChanged" />
                </StackPanel>
            </Grid>

            <!-- Transactions fictives -->
            <Border Style="{StaticResource DmxCard}">
                <StackPanel Spacing="14">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Transactions fictives" Style="{StaticResource DmxCardTitle}" />
                            <TextBlock Text="Elles modifient uniquement cette projection et ne sont pas ajoutées au journal." Style="{StaticResource DmxCaption}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ClearFakeButton" Command="{x:Bind ViewModel.ClearFakeTransactionsCommand}" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <local:LucideIcon Glyph="Trash2" Size="14" />
                                    <TextBlock Text="Tout retirer" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.NewFakeTransactionCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <local:LucideIcon Glyph="Plus" Size="14" Stroke="White" />
                                    <TextBlock Text="Ajouter" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="FakeSummary" Visibility="Collapsed">
                        <TextBlock x:Name="FakeCount" Style="{StaticResource DmxCaption}" />
                        <TextBlock x:Name="FakeImpact" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
                    </Grid>

                    <ItemsControl x:Name="FakeList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="interop:FakeTransactionRow">
                                <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DmxSeparator}" Padding="0,10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            Grid.Column="0"
                                            IsChecked="{x:Bind Transaction.Enabled}"
                                            Tag="{x:Bind Transaction.Id}"
                                            Checked="OnToggleFake"
                                            Unchecked="OnToggleFake"
                                            MinWidth="0" />
                                        <Border Grid.Column="1" Width="34" Height="34" CornerRadius="10" Background="{x:Bind local:Format.KindTint(Transaction.TransactionType)}">
                                            <local:LucideIcon Glyph="{x:Bind local:Format.KindGlyph(Transaction.TransactionType)}" Size="16" Stroke="{x:Bind local:Format.KindBrush(Transaction.TransactionType)}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Transaction.Description}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <Border CornerRadius="4" Padding="6,1" Background="{ThemeResource DmxSubtleBackground}">
                                                    <TextBlock Text="{x:Bind TypeLabel}" FontSize="10" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind local:Format.FakeDetails(Transaction.Date, SourceAccountName, DestinationAccountName, CategoryName)}" Style="{StaticResource DmxCaption}" FontSize="11" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{x:Bind local:Format.Signed(Transaction.Amount, Transaction.TransactionType)}"
                                            Foreground="{x:Bind local:Format.KindBrush(Transaction.TransactionType)}"
                                            Style="{StaticResource DmxAmount}"
                                            VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Background="Transparent" BorderThickness="0" Padding="5" Tag="{x:Bind Transaction.Id}" Click="OnEditFake" ToolTipService.ToolTip="Modifier cette transaction fictive">
                                                <local:LucideIcon Glyph="Edit2" Size="14" />
                                            </Button>
                                            <Button Background="Transparent" BorderThickness="0" Padding="5" Tag="{x:Bind Transaction.Id}" Click="OnRemoveFake" ToolTipService.ToolTip="Retirer cette transaction fictive">
                                                <local:LucideIcon Glyph="Trash2" Size="14" Stroke="{ThemeResource DmxExpense}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="FakeEmpty" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource DmxSeparator}" Padding="16">
                        <TextBlock Text="Aucune transaction fictive appliquée à cette projection." Style="{StaticResource DmxCaption}" HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Projection -->
            <Border Style="{StaticResource DmxCard}">
                <StackPanel Spacing="14">
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="ProjectionTitle" Style="{StaticResource DmxCardTitle}" />
                            <TextBlock Text="Visualisation de la trésorerie jour par jour." Style="{StaticResource DmxCaption}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox x:Name="MonthStartsOnFirst" Content="Démarrer au 1er du mois" Checked="OnMonthStartChanged" Unchecked="OnMonthStartChanged" />
                            <CheckBox
                                x:Name="IntradayLow"
                                Content="Point bas journalier"
                                Checked="OnIntradayChanged"
                                Unchecked="OnIntradayChanged"
                                ToolTipService.ToolTip="Trace le solde de chaque compte une fois les retraits du jour passés, avant l’arrivée des revenus." />
                        </StackPanel>
                    </Grid>
                    <local:LineChartView x:Name="ProjectionChart" Height="380" />
                    <ItemsControl x:Name="MarkerLegend">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Jours à surveiller -->
            <Border x:Name="RiskCard" Style="{StaticResource DmxCard}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <local:LucideIcon Glyph="ShieldAlert" Size="18" Stroke="{ThemeResource DmxWarning}" />
                        <TextBlock x:Name="RiskTitle" Style="{StaticResource DmxCardTitle}" />
                    </StackPanel>
                    <TextBlock
                        Text="Ces jours cumulent un retrait et un revenu. Le solde de fin de journée reste au-dessus du seuil, mais il passe en dessous avant l’arrivée du revenu — de quoi déclencher des frais côté banque."
                        Style="{StaticResource DmxCaption}"
                        TextWrapping="Wrap" />
                    <ItemsControl x:Name="RiskDays">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="interop:PredictionMarker">
                                <StackPanel Spacing="4" Padding="12,10">
                                    <TextBlock Text="{x:Bind FullLabel}" FontSize="13" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{x:Bind IntradayBalances}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="interop:IntradayBalance">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}" Style="{StaticResource DmxCaption}" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind local:Format.LowLabel(Low)}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource DmxWarning}" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind local:Format.CloseLabel(Value)}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource DmxIncome}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="RiskMore" Style="{StaticResource DmxCaption}" FontSize="11" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Totaux -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource DmxCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="SOLDE ACTUEL TOTAL" Style="{StaticResource DmxSectionLabel}" />
                        <TextBlock x:Name="CurrentTotal" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource DmxCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="PROJECTION MI-PÉRIODE" Style="{StaticResource DmxSectionLabel}" />
                        <TextBlock x:Name="MidpointTotal" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource DmxCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="FinalLabel" Style="{StaticResource DmxSectionLabel}" />
                        <TextBlock x:Name="FinalTotal" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Seuil d'alerte -->
            <Border Style="{StaticResource DmxCard}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Seuil d'alerte" Style="{StaticResource DmxCardTitle}" />
                        <TextBlock
                            Text="Le seuil personnalisé s'affiche en orange. Le rouge reste réservé aux soldes négatifs. Les jours où un retrait passe avant un revenu sont signalés à part, même si la journée se termine au-dessus du seuil."
                            Style="{StaticResource DmxCaption}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox
                        Grid.Column="1"
                        x:Name="ThresholdBox"
                        Header="Montant"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.ThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        LostFocus="OnThresholdCommitted"
                        KeyDown="OnThresholdKeyDown" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
