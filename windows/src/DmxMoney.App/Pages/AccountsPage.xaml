<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DmxMoney.App.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DmxMoney.App"
    xmlns:interop="using:DmxMoney.Interop">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="1280">
            <Grid>
                <TextBlock Text="Mes Comptes" Style="{StaticResource DmxPageTitle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Command="{x:Bind ViewModel.ManageGroupsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <local:LucideIcon Glyph="Settings" Size="14" />
                            <TextBlock Text="Gérer les groupes" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.NewAccountCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <local:LucideIcon Glyph="Plus" Size="14" Stroke="White" />
                            <TextBlock Text="Nouveau compte" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox
                    x:Name="SearchBox"
                    PlaceholderText="Rechercher un compte..."
                    Width="320"
                    Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DropDownButton x:Name="TypesButton" Content="Tous les types" MinWidth="180">
                    <DropDownButton.Flyout>
                        <Flyout>
                            <ListView
                                x:Name="TypesList"
                                SelectionMode="Multiple"
                                Width="200"
                                SelectionChanged="OnTypesChanged" />
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>

            <!-- Un bloc par groupe : en-tête, puis les cartes de comptes -->
            <ItemsControl x:Name="Groups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="interop:AccountGroupSection">
                        <StackPanel Spacing="14" Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Name}" FontSize="17" FontWeight="SemiBold" />
                                <Border CornerRadius="10" Padding="8,1" Background="{ThemeResource DmxSubtleBackground}" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Accounts.Length}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <ItemsRepeater ItemsSource="{x:Bind Accounts}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="300" MinItemHeight="150" MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="interop:AccountCard">
                                        <Border Style="{StaticResource DmxCard}" Padding="18">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="{x:Bind local:Format.Tint(Account.Color)}">
                                                        <local:LucideIcon Glyph="{x:Bind Account.Icon}" Size="22" Stroke="{x:Bind local:Format.Brush(Account.Color)}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Account.Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Account.AccountType}" Style="{StaticResource DmxCaption}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Background="Transparent" BorderThickness="0" Padding="6" Tag="{x:Bind Account.Id}" Click="OnEditAccount" ToolTipService.ToolTip="Modifier">
                                                            <local:LucideIcon Glyph="Edit2" Size="14" />
                                                        </Button>
                                                        <Button Background="Transparent" BorderThickness="0" Padding="6" Tag="{x:Bind Account.Id}" Click="OnDeleteAccount" ToolTipService.ToolTip="Supprimer">
                                                            <local:LucideIcon Glyph="Trash2" Size="14" Stroke="{ThemeResource DmxExpense}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Solde actuel" Style="{StaticResource DmxCaption}" />
                                                    <TextBlock
                                                        Text="{x:Bind local:Format.Money(CurrentBalance)}"
                                                        Foreground="{x:Bind local:Format.AmountBrush(CurrentBalance)}"
                                                        FontSize="24"
                                                        FontWeight="Bold" />
                                                </StackPanel>
                                                <Border Height="1" Background="{ThemeResource DmxSeparator}" />
                                                <Grid>
                                                    <TextBlock Text="Solde pointé" Style="{StaticResource DmxCaption}" />
                                                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind local:Format.Money(CheckedBalance)}" Style="{StaticResource DmxCaption}" FontWeight="SemiBold" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="EmptyState" Style="{StaticResource DmxCard}" Padding="24" Visibility="Collapsed">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyMessage" Style="{StaticResource DmxCaption}" HorizontalAlignment="Center" />
                    <Button x:Name="EmptyAction" Content="Créer votre premier compte" HorizontalAlignment="Center" Command="{x:Bind ViewModel.NewAccountCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
