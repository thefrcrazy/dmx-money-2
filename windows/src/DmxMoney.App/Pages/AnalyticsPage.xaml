<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DmxMoney.App.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DmxMoney.App"
    xmlns:interop="using:DmxMoney.Interop">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="1280">
            <Grid>
                <TextBlock Text="Analyses Financières" Style="{StaticResource DmxPageTitle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <ComboBox x:Name="RangeBox" MinWidth="170" DisplayMemberPath="Label" SelectionChanged="OnRangeChanged" />
                    <StackPanel x:Name="CustomDates" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <CalendarDatePicker x:Name="StartPicker" Header="Du" DateChanged="OnStartChanged" />
                        <CalendarDatePicker x:Name="EndPicker" Header="Au" DateChanged="OnEndChanged" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource DmxCard}">
                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="Évolution du Solde" Style="{StaticResource DmxCardTitle}" VerticalAlignment="Center" />
                        <CheckBox
                            x:Name="MonthStartsOnFirst"
                            Content="Démarrer au 1er du mois"
                            HorizontalAlignment="Right"
                            Checked="OnMonthStartChanged"
                            Unchecked="OnMonthStartChanged" />
                    </Grid>
                    <local:LineChartView x:Name="BalanceChart" Height="320" />
                    <ItemsControl x:Name="BalanceLegend">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="14" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="interop:ChartSeries">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Rectangle Width="14" Height="3" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Fill="{x:Bind local:Format.Brush(Color)}" />
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource DmxCaption}" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource DmxCard}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Dépenses par Catégorie" Style="{StaticResource DmxCardTitle}" />
                        <local:DonutChartView x:Name="ExpenseDonut" Height="210" Thickness="30" />
                        <TextBlock x:Name="ExpenseEmpty" Text="Aucune donnée à afficher" Style="{StaticResource DmxCaption}" HorizontalAlignment="Center" Visibility="Collapsed" />
                        <ItemsControl x:Name="ExpenseLegend">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="interop:CategorySlice">
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="4,3"
                                        Tag="{x:Bind}"
                                        Click="OnToggleExpense">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Width="10" Height="10" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Fill="{x:Bind local:Format.LegendBrush(Hidden, Category.Color)}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Category.Name}" FontSize="12" TextDecorations="{x:Bind local:Format.Strike(Hidden)}" Foreground="{x:Bind local:Format.LegendTextBrush(Hidden)}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind local:Format.SlicePercent(Hidden, Percentage)}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind local:Format.Money(Value)}" FontSize="12" FontWeight="Medium" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource DmxCard}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Revenus par Catégorie" Style="{StaticResource DmxCardTitle}" />
                        <local:DonutChartView x:Name="IncomeDonut" Height="210" Thickness="30" />
                        <TextBlock x:Name="IncomeEmpty" Text="Aucune donnée à afficher" Style="{StaticResource DmxCaption}" HorizontalAlignment="Center" Visibility="Collapsed" />
                        <ItemsControl x:Name="IncomeLegend">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="interop:CategorySlice">
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="4,3"
                                        Tag="{x:Bind}"
                                        Click="OnToggleIncome">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Width="10" Height="10" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Fill="{x:Bind local:Format.LegendBrush(Hidden, Category.Color)}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Category.Name}" FontSize="12" TextDecorations="{x:Bind local:Format.Strike(Hidden)}" Foreground="{x:Bind local:Format.LegendTextBrush(Hidden)}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind local:Format.SlicePercent(Hidden, Percentage)}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind local:Format.Money(Value)}" FontSize="12" FontWeight="Medium" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource DmxCard}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Revenus vs Dépenses" Style="{StaticResource DmxCardTitle}" />
                    <local:BarChartView x:Name="ComparisonChart" Height="320" />
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{ThemeResource DmxIncome}" />
                            <TextBlock Text="Revenus" Style="{StaticResource DmxCaption}" FontSize="11" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{ThemeResource DmxExpense}" />
                            <TextBlock Text="Dépenses" Style="{StaticResource DmxCaption}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
