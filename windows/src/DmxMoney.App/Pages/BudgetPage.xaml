<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DmxMoney.App.BudgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DmxMoney.App"
    xmlns:interop="using:DmxMoney.Interop">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="1280">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Budget" Style="{StaticResource DmxPageTitle}" />
                    <TextBlock x:Name="Subtitle" Style="{StaticResource DmxCaption}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SuggestionsButton" Command="{x:Bind ViewModel.ShowSuggestionsCommand}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <local:LucideIcon Glyph="Sparkles" Size="14" />
                            <TextBlock x:Name="SuggestionsLabel" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.NewBudgetCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <local:LucideIcon Glyph="Plus" Size="14" Stroke="White" />
                            <TextBlock Text="Nouveau budget" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Indicateurs -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource DmxCard}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="PRÉVU" Style="{StaticResource DmxSectionLabel}" />
                            <local:LucideIcon Glyph="CalendarClock" Size="15" HorizontalAlignment="Right" Stroke="{ThemeResource DmxAccent}" />
                        </Grid>
                        <TextBlock x:Name="PlannedValue" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="PlannedCaption" Style="{StaticResource DmxCaption}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource DmxCard}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="DÉPENSÉ" Style="{StaticResource DmxSectionLabel}" />
                            <local:LucideIcon Glyph="TrendingDown" Size="15" HorizontalAlignment="Right" Stroke="{ThemeResource DmxExpense}" />
                        </Grid>
                        <TextBlock x:Name="SpentValue" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="SpentCaption" Style="{StaticResource DmxCaption}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource DmxCard}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="RESTANT" Style="{StaticResource DmxSectionLabel}" />
                            <local:LucideIcon x:Name="RemainingIcon" Glyph="Wallet" Size="15" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="RemainingValue" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="RemainingCaption" Style="{StaticResource DmxCaption}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource DmxCard}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="ÉTAT" Style="{StaticResource DmxSectionLabel}" />
                            <local:LucideIcon x:Name="StateIcon" Glyph="CheckCircle2" Size="15" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="StateValue" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="StateCaption" Style="{StaticResource DmxCaption}" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Consommation du mois -->
            <Border Style="{StaticResource DmxCard}">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Consommation du mois" Style="{StaticResource DmxCardTitle}" />
                            <TextBlock Text="Le budget suit les enveloppes configurées et les dépenses du Journal." Style="{StaticResource DmxCaption}" />
                        </StackPanel>
                        <TextBlock x:Name="ProgressLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource DmxCaption}" />
                    </Grid>
                    <local:ProgressBarView x:Name="ProgressBar" Height="12" />
                    <TextBlock x:Name="ProgressDetails" Style="{StaticResource DmxCaption}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Budget par catégorie -->
            <Border Style="{StaticResource DmxCard}" Padding="0">
                <StackPanel>
                    <Grid Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="Budget par catégorie" Style="{StaticResource DmxCardTitle}" />
                            <TextBlock Text="Catégories configurées, enveloppes et suivi détaillé." Style="{StaticResource DmxCaption}" FontSize="11" />
                        </StackPanel>
                        <TextBlock x:Name="CategoryCount" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource DmxCaption}" FontSize="11" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DmxSeparator}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="18,10">
                        <TextBox
                            PlaceholderText="Rechercher un budget..."
                            Width="300"
                            Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <DropDownButton x:Name="CategoriesButton" Content="Toutes les catégories" MinWidth="180">
                            <DropDownButton.Flyout>
                                <Flyout>
                                    <ListView x:Name="CategoriesList" SelectionMode="Multiple" Width="240" MaxHeight="360" DisplayMemberPath="Name" SelectionChanged="OnCategoriesChanged" />
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                    <Border Height="1" Background="{ThemeResource DmxSeparator}" />

                    <ItemsControl x:Name="CategoryRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="interop:BudgetCategoryRow">
                                <StackPanel Spacing="12" Padding="18,14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="{x:Bind local:Format.Tint(Category.Color)}">
                                            <local:LucideIcon Glyph="{x:Bind Category.Icon}" Size="18" Stroke="{x:Bind local:Format.Brush(Category.Color)}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Category.Name}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind local:Format.Envelopes(Envelopes.Length, LinkedScheduledCount)}" Style="{StaticResource DmxCaption}" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button
                                                Tag="{x:Bind Category.Id}"
                                                Click="OnCreateBudgetForCategory"
                                                Visibility="{x:Bind local:Format.Visible(IsUnbudgeted)}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <local:LucideIcon Glyph="Plus" Size="12" />
                                                    <TextBlock Text="Créer un budget" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind local:Format.Visible(IsOverBudget)}">
                                                <local:LucideIcon Glyph="AlertCircle" Size="13" Stroke="{ThemeResource DmxExpense}" />
                                                <TextBlock Text="Dépassé" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource DmxExpense}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind local:Format.OkVisible(IsOverBudget, IsUnbudgeted)}">
                                                <local:LucideIcon Glyph="CheckCircle2" Size="13" Stroke="{ThemeResource DmxIncome}" />
                                                <TextBlock Text="OK" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource DmxIncome}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{x:Bind Envelopes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="interop:BudgetEnvelope">
                                                <Border CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource DmxSeparator}" Padding="14,10" Margin="0,0,0,8">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="100" />
                                                                <ColumnDefinition Width="100" />
                                                                <ColumnDefinition Width="100" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{x:Bind Budget.Name}" FontSize="13" FontWeight="Medium" />
                                                                <TextBlock Text="{x:Bind AccountName}" Style="{StaticResource DmxCaption}" FontSize="11" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{x:Bind local:Format.Money(Budget.Amount)}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{x:Bind local:Format.Money(Spent)}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="3" Text="{x:Bind local:Format.Money(Remaining)}" Foreground="{x:Bind local:Format.PositiveBrush(Remaining)}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                                <Button Background="Transparent" BorderThickness="0" Padding="5" Tag="{x:Bind Budget.Id}" Click="OnEditBudget" ToolTipService.ToolTip="Modifier">
                                                                    <local:LucideIcon Glyph="Edit2" Size="14" />
                                                                </Button>
                                                                <Button Background="Transparent" BorderThickness="0" Padding="5" Tag="{x:Bind Budget.Id}" Click="OnDeleteBudget" ToolTipService.ToolTip="Supprimer">
                                                                    <local:LucideIcon Glyph="Trash2" Size="14" Stroke="{ThemeResource DmxExpense}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                        <local:EnvelopeProgress Envelope="{x:Bind}" />
                                                        <ItemsControl ItemsSource="{x:Bind LinkedScheduled}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="interop:LinkedScheduled">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <local:LucideIcon Glyph="CalendarClock" Size="11" Stroke="{ThemeResource DmxAccent}" />
                                                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource DmxCaption}" FontSize="11" />
                                                                        <TextBlock Text="{x:Bind local:Format.Signed(Amount, TransactionType)}" Foreground="{x:Bind local:Format.KindBrush(TransactionType)}" FontSize="11" FontWeight="SemiBold" />
                                                                        <TextBlock Text="·" Style="{StaticResource DmxCaption}" FontSize="11" />
                                                                        <TextBlock Text="{x:Bind local:Format.Short(NextDate)}" Style="{StaticResource DmxCaption}" FontSize="11" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="EmptyState" Spacing="8" Padding="24" Visibility="Collapsed">
                        <TextBlock x:Name="EmptyTitle" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyMessage" Style="{StaticResource DmxCaption}" HorizontalAlignment="Center" />
                        <Button x:Name="EmptyAction" Content="Nouveau budget" HorizontalAlignment="Center" Command="{x:Bind ViewModel.NewBudgetCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
