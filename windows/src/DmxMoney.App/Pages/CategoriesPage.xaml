<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DmxMoney.App.CategoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DmxMoney.App"
    xmlns:interop="using:DmxMoney.Interop">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="1280">
            <Grid>
                <TextBlock Text="Gestion des Catégories" Style="{StaticResource DmxPageTitle}" VerticalAlignment="Center" />
                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Command="{x:Bind ViewModel.NewCategoryCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <local:LucideIcon Glyph="Plus" Size="14" Stroke="White" />
                        <TextBlock Text="Nouvelle catégorie" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBox
                PlaceholderText="Rechercher une catégorie..."
                Width="320"
                HorizontalAlignment="Left"
                Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ItemsRepeater x:Name="CategoryGrid">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="260" MinItemHeight="60" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="interop:Category">
                        <Border Style="{StaticResource DmxCard}" Padding="12">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="{x:Bind local:Format.Tint(Color)}">
                                    <local:LucideIcon Glyph="{x:Bind Icon}" Size="18" Stroke="{x:Bind local:Format.Brush(Color)}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{x:Bind local:Format.Hidden(local:CategoriesPage.IsLocked(Id))}">
                                    <Button Background="Transparent" BorderThickness="0" Padding="6" Tag="{x:Bind Id}" Click="OnEdit" ToolTipService.ToolTip="Modifier">
                                        <local:LucideIcon Glyph="Edit2" Size="14" />
                                    </Button>
                                    <Button Background="Transparent" BorderThickness="0" Padding="6" Tag="{x:Bind Id}" Click="OnDelete" ToolTipService.ToolTip="Supprimer">
                                        <local:LucideIcon Glyph="Trash2" Size="14" Stroke="{ThemeResource DmxExpense}" />
                                    </Button>
                                </StackPanel>
                                <local:LucideIcon
                                    Grid.Column="2"
                                    Glyph="Lock"
                                    Size="14"
                                    Margin="6,0"
                                    VerticalAlignment="Center"
                                    Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                                    Visibility="{x:Bind local:Format.Visible(local:CategoriesPage.IsLocked(Id))}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border x:Name="EmptyState" Style="{StaticResource DmxCard}" Padding="24" Visibility="Collapsed">
                <TextBlock Text="Aucune catégorie ne correspond à la recherche." Style="{StaticResource DmxCaption}" HorizontalAlignment="Center" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
