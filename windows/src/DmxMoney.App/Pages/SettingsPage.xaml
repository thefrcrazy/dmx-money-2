<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DmxMoney.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DmxMoney.App"
    xmlns:interop="using:DmxMoney.Interop">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="28" MaxWidth="760">
            <TextBlock Text="Paramètres" FontSize="28" FontWeight="Bold" />

            <!-- Apparence -->
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <local:AppIcon Icon="Palette" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="APPARENCE" Style="{StaticResource DmxSectionLabel}" />
                </StackPanel>
                <Border Style="{StaticResource DmxCard}" Padding="0" CornerRadius="14">
                    <StackPanel>
                        <Grid Padding="16">
                            <StackPanel>
                                <TextBlock Text="Thème de l'interface" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Choisissez l'aspect visuel de l'application" Style="{StaticResource DmxCaption}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ToggleButton x:Name="LightTheme" Click="OnThemeClicked" Tag="light" Padding="12,6" ToolTipService.ToolTip="Clair">
                                    <local:AppIcon Icon="Sun" FontSize="15" />
                                </ToggleButton>
                                <ToggleButton x:Name="DarkTheme" Click="OnThemeClicked" Tag="dark" Padding="12,6" ToolTipService.ToolTip="Sombre">
                                    <local:AppIcon Icon="Moon" FontSize="15" />
                                </ToggleButton>
                                <ToggleButton x:Name="SystemTheme" Click="OnThemeClicked" Tag="system" Padding="12,6" ToolTipService.ToolTip="Système">
                                    <local:AppIcon Icon="Monitor" FontSize="15" />
                                </ToggleButton>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DmxSeparator}" />
                        <StackPanel Padding="16" Spacing="10">
                            <StackPanel>
                                <TextBlock Text="Couleur d'accentuation" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Personnalisez la couleur principale" Style="{StaticResource DmxCaption}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="DefaultAccent" Click="OnDefaultAccent" Width="30" Height="30" CornerRadius="15" Padding="0" Content="Def" FontSize="10" FontWeight="Bold" />
                                <Rectangle Width="1" Height="20" Fill="{ThemeResource DmxSeparator}" VerticalAlignment="Center" />
                                <ItemsControl x:Name="AccentColors">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Mode compagnon mobile -->
            <StackPanel x:Name="BridgeSection" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <local:AppIcon Icon="Smartphone" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="MODE COMPAGNON MOBILE" Style="{StaticResource DmxSectionLabel}" />
                </StackPanel>
                <Border Style="{StaticResource DmxCard}" Padding="0" CornerRadius="14">
                    <StackPanel>
                        <StackPanel Padding="16" Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{ThemeResource DmxSubtleBackground}">
                                    <local:AppIcon Icon="Lock" FontSize="16" Foreground="{ThemeResource DmxIncome}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Accès mobile local + PWA" FontSize="14" FontWeight="SemiBold" />
                                        <Border x:Name="BridgeBadgeHost" CornerRadius="10" Padding="8,1" Background="{ThemeResource DmxSubtleBackground}">
                                            <TextBlock x:Name="BridgeBadge" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="BridgeDetail" Style="{StaticResource DmxCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" x:Name="BridgeSwitch" OnContent="Activé" OffContent="Activer" Toggled="OnBridgeToggled" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="10" Padding="10,8" Background="{ThemeResource DmxSubtleBackground}">
                                    <StackPanel>
                                        <TextBlock Text="PWA MOBILE" Style="{StaticResource DmxSectionLabel}" />
                                        <TextBlock x:Name="AppUrl" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="10" Padding="10,8" Background="{ThemeResource DmxSubtleBackground}">
                                    <StackPanel>
                                        <TextBlock Text="API LOCALE SÉCURISÉE" Style="{StaticResource DmxSectionLabel}" />
                                        <TextBlock x:Name="ApiUrl" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DmxSeparator}" />
                        <Grid Padding="16" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="8">
                                <ItemsControl x:Name="BridgeSteps" />
                                <TextBlock x:Name="BridgeError" Style="{StaticResource DmxCaption}" Foreground="{ThemeResource DmxWarning}" TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <Border CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource DmxSeparator}" Padding="12">
                                    <StackPanel Spacing="10">
                                        <Border Width="128" Height="128" CornerRadius="10" Background="White">
                                            <Grid>
                                                <Image x:Name="QrCode" Stretch="Uniform" Margin="6" />
                                                <TextBlock x:Name="QrEmpty" FontSize="11" Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center" Margin="10" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Button x:Name="PairingButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnRegeneratePairing">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <local:AppIcon Icon="KeyRound" FontSize="13" Foreground="White" />
                                                <TextBlock x:Name="PairingLabel" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="CopyButton" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CopyPairingUrlCommand}" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <local:AppIcon Icon="Copy" FontSize="13" />
                                                <TextBlock Text="Copier" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    Text="Ouvre la PWA sur mobile, puis appaire le téléphone avec ce QR. Génère un QR par appareil : plusieurs mobiles peuvent rester appairés."
                                    Style="{StaticResource DmxCaption}"
                                    FontSize="11"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DmxSeparator}" />
                        <StackPanel Padding="16" Spacing="8">
                            <TextBlock x:Name="PasskeysTitle" Style="{StaticResource DmxSectionLabel}" />
                            <ItemsControl x:Name="Passkeys">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="interop:PasskeyInfo">
                                        <Border CornerRadius="10" Padding="10" Margin="0,0,0,6" Background="{ThemeResource DmxSubtleBackground}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <local:AppIcon Grid.Column="0" Icon="Smartphone" FontSize="16" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{x:Bind local:Format.PasskeyName(DeviceLabel)}" FontSize="12" FontWeight="Medium" />
                                                    <TextBlock Text="{x:Bind local:Format.PasskeyMeta(CreatedAt, LastUsedAt)}" Style="{StaticResource DmxCaption}" FontSize="11" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="Désappairer" FontSize="11" Tag="{x:Bind}" Click="OnRevokePasskey" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoPasskeys" Text="Aucun mobile appairé pour l’instant." Style="{StaticResource DmxCaption}" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Données -->
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <local:AppIcon Icon="HardDrive" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="DONNÉES &amp; STOCKAGE" Style="{StaticResource DmxSectionLabel}" />
                </StackPanel>
                <Border Style="{StaticResource DmxCard}" Padding="0" CornerRadius="14">
                    <StackPanel>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="16" Command="{x:Bind ViewModel.ExportDataCommand}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9" Background="{ThemeResource DmxSubtleBackground}">
                                    <local:AppIcon Icon="Download" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Exporter les données" FontSize="14" FontWeight="Medium" />
                                    <TextBlock Text="Créer une sauvegarde locale (.dmx)" Style="{StaticResource DmxCaption}" />
                                </StackPanel>
                                <local:AppIcon Grid.Column="2" Icon="ChevronRight" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </Button>
                        <Border Height="1" Background="{ThemeResource DmxSeparator}" />
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="16" Command="{x:Bind ViewModel.ImportDataCommand}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9" Background="{ThemeResource DmxSubtleBackground}">
                                    <local:AppIcon Icon="Upload" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Importer ou Restaurer" FontSize="14" FontWeight="Medium" />
                                    <TextBlock Text="Depuis un backup ou un fichier CSV/OFX/QIF" Style="{StaticResource DmxCaption}" />
                                </StackPanel>
                                <local:AppIcon Grid.Column="2" Icon="ChevronRight" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- À propos -->
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <local:AppIcon Icon="Info" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="À PROPOS" Style="{StaticResource DmxSectionLabel}" />
                </StackPanel>
                <Border Style="{StaticResource DmxCard}" Padding="0" CornerRadius="14">
                    <StackPanel>
                        <Grid Padding="16">
                            <StackPanel>
                                <TextBlock Text="DmxMoney" FontSize="14" FontWeight="Medium" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource DmxCaption}" />
                            </StackPanel>
                            <Button Content="Nouveautés" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{x:Bind ViewModel.ShowWhatsNewCommand}" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DmxSeparator}" />
                        <Grid Padding="16">
                            <StackPanel>
                                <TextBlock Text="Mise à jour logicielle" FontSize="14" FontWeight="Medium" />
                                <TextBlock x:Name="UpdateStatus" Style="{StaticResource DmxCaption}" />
                            </StackPanel>
                            <Button x:Name="UpdateButton" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{x:Bind ViewModel.CheckForUpdatesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <local:AppIcon Icon="RefreshCw" FontSize="13" />
                                    <TextBlock x:Name="UpdateLabel" Text="Vérifier" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DmxSeparator}" />
                        <CheckBox
                            Content="Autoriser les versions pré-release (bêta / RC)"
                            IsChecked="{x:Bind ViewModel.IncludePrereleases, Mode=TwoWay}"
                            Margin="16,8,16,14" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
