<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="DmxCardBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="DmxPageBackground" Color="#FFF4F4F6" />
            <SolidColorBrush x:Key="DmxSeparator" Color="#14000000" />
            <SolidColorBrush x:Key="DmxSubtleBackground" Color="#0A000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="DmxCardBackground" Color="#FF1C1C1E" />
            <SolidColorBrush x:Key="DmxPageBackground" Color="#FF101012" />
            <SolidColorBrush x:Key="DmxSeparator" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="DmxSubtleBackground" Color="#0DFFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Couleurs sémantiques, identiques sur macOS, Windows et Linux. -->
    <SolidColorBrush x:Key="DmxIncome" Color="#FF10B981" />
    <SolidColorBrush x:Key="DmxExpense" Color="#FFEF4444" />
    <SolidColorBrush x:Key="DmxTransfer" Color="#FF6366F1" />
    <SolidColorBrush x:Key="DmxWarning" Color="#FFF97316" />
    <SolidColorBrush x:Key="DmxChecked" Color="#FF059669" />
    <SolidColorBrush x:Key="DmxMuted" Color="#FF9CA3AF" />
    <SolidColorBrush x:Key="DmxAccent" Color="#FF6366F1" />

    <Style x:Key="DmxCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DmxCardBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DmxSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="DmxSectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="DmxPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="DmxCardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="DmxCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="DmxAmount" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

</ResourceDictionary>
